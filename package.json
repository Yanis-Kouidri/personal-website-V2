{
  "name": "personal-website-v2",
  "type": "module",
  "version": "0.0.11",
  "scripts": {
    "dev": "astro dev --open",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "astro check",
