{
	auto_https off
}

:8080 {
	root * /usr/share/caddy
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	import ./csp_header.caddy

	route {
		handle /healthz {
			log_skip
			respond "OK" 200
		}

		handle /ready {
			log_skip
			@file_exists file /index.html
			respond @file_exists "Ready" 200
			respond "Not Ready" 503
		}

		try_files {path} {path}/index.html /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
