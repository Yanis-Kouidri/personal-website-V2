---
import { getLocalizedEntry } from "../i18n/content";
import { Picture } from "astro:assets";
import profileImage from "../assets/Yanis_Kouidri_home.jpg";
import { ICONS } from "./icons";

const homeEntry = await getLocalizedEntry("home", Astro.currentLocale);
const { title, subtitle, ctaLabel, ctaHref, imageAlt, socialLinks } =
  homeEntry.data;
---

<section id="home" class="hero-container">
  <div class="content-wrapper">
    <div class="text-content">
      <h1 class="name-title">{title}</h1>
      <p class="description">{subtitle}</p>

      <div class="social-links">
        {socialLinks.map((social) => {
          const IconComponent = ICONS[social.icon];
          return (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="link-icon"
            >
              <IconComponent size={32} stroke-width="2.5" />
            </a>
          );
        })}
      </div>

      <a href={ctaHref} class="btn-cta">
        {ctaLabel}
      </a>
    </div>

    <div class="profile-image-container">
      <!-- Rendered at 250px (mobile) and 380px (desktop), 1x and 2x -->
      <Picture
        src={profileImage}
        formats={["avif"]}
        fallbackFormat="webp"
        alt={imageAlt}
        class="img-cover"
        width={380}
        height={380}
        widths={[250, 380, 500, 760]}
        sizes="(min-width: 1024px) 380px, 250px"
        priority
      />
    </div>
  </div>
</section>

<style>
  .hero-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 80px);
    background-color: var(--color-background);
    padding: 2rem 1.5rem;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3rem;
    width: 100%;
    max-width: 1200px;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .name-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-font);
  }

  .description {
    font-size: 1.25rem;
    max-width: 500px;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .profile-image-container {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  /* --- Desktop Breakpoint (1024px+) --- */
  @media (min-width: 1024px) {
    .content-wrapper {
      flex-direction: row;
      justify-content: center;
      text-align: left;

      gap: 8rem;
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 10% 6rem 10%;
    }

    .text-content {
      align-items: flex-start;
      flex: 0 1 auto;
    }

    .profile-image-container {
      flex-shrink: 0;
      width: 380px;
      height: 380px;
    }
  }
</style>
