---
/**
 * LangSwitcher Component
 * Desktop language dropdown (the mobile menu lists the languages itself)
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { LANGUAGES, LOCALES, toLocale } from "../i18n/locales";
import Flag from "./Flag.astro";

interface Props {
  label: string;
}

const { label } = Astro.props;
const currentLocale = toLocale(Astro.currentLocale);
const currentCode = currentLocale.toUpperCase();
---

<div class="lang-switcher">
  <button
    id="lang-button"
    type="button"
    class="lang-btn"
    aria-label={`${label} – ${currentCode}`}
    aria-expanded="false"
  >
    <Flag locale={currentLocale} />
    <span class="lang-label">{currentCode}</span>
    <svg
      class="lang-chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <ul id="lang-dropdown" class="lang-dropdown">
    {LOCALES.map((locale) => (
      <li>
        <a
          href={getRelativeLocaleUrl(locale)}
          lang={locale}
          hreflang={locale}
          class:list={["lang-option", { active: locale === currentLocale }]}
        >
          <Flag locale={locale} />
          {LANGUAGES[locale].label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Desktop only: on mobile, the languages are listed in the burger menu */
  .lang-switcher {
    display: none;
    position: relative;
  }

  @media (min-width: 1024px) {
    .lang-switcher {
      display: block;
    }
  }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-font);
    transition: border-color 0.2s ease;
  }

  .lang-btn:hover {
    border-color: var(--color-primary);
  }

  .lang-label {
    font-size: 0.8rem;
  }

  .lang-chevron {
    transition: transform 0.2s ease;
  }

  .lang-btn[aria-expanded="true"] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    min-width: 150px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      transform 0.2s ease;
  }

  .lang-dropdown.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-font);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.15s ease;
  }

  .lang-option:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .lang-option.active {
    background-color: rgba(0, 110, 26, 0.08);
    color: var(--color-primary);
    font-weight: 600;
  }
</style>

<script>
  /**
   * Setup language switcher dropdown behavior (desktop)
   */
  const setupLangSwitcher = (): void => {
    const langBtn = document.getElementById(
      "lang-button",
    ) as HTMLButtonElement | null;
    const langDropdown = document.getElementById(
      "lang-dropdown",
    ) as HTMLElement | null;

    if (!langBtn || !langDropdown) return;

    // Toggle dropdown on button click
    langBtn.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = langDropdown.classList.toggle("is-open");
      langBtn.setAttribute("aria-expanded", isOpen.toString());
    });

    // Close dropdown on outside click
    document.addEventListener("click", (event) => {
      if (
        !langBtn.contains(event.target as Node) &&
        !langDropdown.contains(event.target as Node)
      ) {
        langDropdown.classList.remove("is-open");
        langBtn.setAttribute("aria-expanded", "false");
      }
    });

    // Close dropdown on Escape
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        langDropdown.classList.contains("is-open")
      ) {
        langDropdown.classList.remove("is-open");
        langBtn.setAttribute("aria-expanded", "false");
        langBtn.focus();
      }
    });
  };

  // Initialize on DOM load
  setupLangSwitcher();
</script>
