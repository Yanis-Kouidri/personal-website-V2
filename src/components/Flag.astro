---
/**
 * Flag Component
 * Decorative flag of a site locale (the language name is always shown next
 * to it, so it is hidden from assistive technologies).
 */
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const VIEW_BOXES: Record<Locale, string> = {
  fr: "0 0 3 2",
  en: "0 0 60 30",
  ru: "0 0 9 6",
  es: "0 0 9 6",
};
---

<svg
  class="flag"
  viewBox={VIEW_BOXES[locale]}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {locale === "fr" && (
    <>
      <rect width="1" height="2" fill="#002395" />
      <rect x="1" width="1" height="2" fill="#FFF" />
      <rect x="2" width="1" height="2" fill="#ED2939" />
    </>
  )}
  {locale === "en" && (
    <>
      <path d="M0 0v30h60V0z" fill="#012169" />
      <path d="M0 0l60 30m0-30L0 30" stroke="#FFF" stroke-width="6" />
      <path d="M0 0l60 30m0-30L0 30" stroke="#C8102E" stroke-width="4" />
      <path d="M0 15h60M30 0v30" stroke="#FFF" stroke-width="10" />
      <path d="M0 15h60M30 0v30" stroke="#C8102E" stroke-width="6" />
    </>
  )}
  {locale === "ru" && (
    <>
      <rect width="9" height="6" fill="#FFF" />
      <rect y="2" width="9" height="2" fill="#0039A6" />
      <rect y="4" width="9" height="2" fill="#D52B1E" />
    </>
  )}
  {locale === "es" && (
    <>
      <rect width="9" height="6" fill="#C60B1E" />
      <rect y="2" width="9" height="2" fill="#FFC400" />
    </>
  )}
</svg>

<style>
  .flag {
    width: 24px;
    height: 16px;
    border-radius: 2px;
    outline: 1px solid rgba(0, 0, 0, 0.12);
    flex-shrink: 0;
  }
</style>
