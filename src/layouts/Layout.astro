---
import { getLocalizedEntry } from "../i18n/content";
import { DEFAULT_LOCALE, LANGUAGES, LOCALES, toLocale } from "../i18n/locales";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import interFontUrl from "../assets/fonts/InterVariable.woff2?url";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "../lib/og-image";

interface Props {
  /** Overrides the localized default page title */
  title?: string;
  /** Asks search engines not to index the page */
  noindex?: boolean;
}

const { title: titleOverride, noindex = false } = Astro.props;

const currentLocale = toLocale(Astro.currentLocale);

const metaEntry = await getLocalizedEntry("meta", currentLocale);
const { description } = metaEntry.data;
const title = titleOverride ?? metaEntry.data.title;

const homeEntry = await getLocalizedEntry("home", currentLocale);
const { title: name, subtitle } = homeEntry.data;

// --- SEO: canonical URL and language alternates ---
// Path of the current page inside its locale ("" for a locale home page)
const pathInLocale = Astro.url.pathname.slice(
  getRelativeLocaleUrl(currentLocale).length,
);
const canonicalUrl = getAbsoluteLocaleUrl(currentLocale, pathInLocale);
const alternates = LOCALES.map((locale) => ({
  hreflang: locale,
  href: getAbsoluteLocaleUrl(locale, pathInLocale),
}));

// --- Open Graph ---
// Localized preview card generated at build time by src/pages/og/[locale].jpg.ts
const ogImageUrl = new URL(`/og/${currentLocale}.jpg`, Astro.site).href;
const ogImageAlt = `${name} – ${subtitle}`;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={interFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    {
      /* Not on noindex pages (e.g. the 404 page, served at any missing URL) */
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          {alternates.map(({ hreflang, href }) => (
            <link rel="alternate" hreflang={hreflang} href={href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, pathInLocale)}
          />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yanis Kouidri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={LANGUAGES[currentLocale].ogLocale} />
    {LOCALES.filter((locale) => locale !== currentLocale).map((locale) => (
      <meta
        property="og:locale:alternate"
        content={LANGUAGES[locale].ogLocale}
      />
    ))}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
